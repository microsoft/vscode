sequenceDiagram
    actor Developer
    participant S as :VSCodeSystem
    Developer->>S: startDebugSession(configurationId: ConfigurationID)
    S-->>Developer: trustRequired(workspaceId: WorkspaceID)
    Developer->>S: grantWorkspaceTrust(workspaceId: WorkspaceID)
