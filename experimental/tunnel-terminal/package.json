{
	"name": "experimental-tunnel-terminal",
	"displayName": "%displayName%",
	"description": "%description%",
	"version": "0.0.1",
	"publisher": "vscode-experiments",
	"private": true,
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/microsoft/vscode.git",
		"directory": "experimental/tunnel-terminal"
	},
	"engines": {
		"vscode": "^1.95.0",
		"node": ">=22"
	},
	"extensionKind": ["workspace"],
	"categories": ["Other"],
	"main": "./dist/extension.cjs",
	"capabilities": {
		"untrustedWorkspaces": {
			"supported": false
		},
		"virtualWorkspaces": false
	},
	"contributes": {
		"commands": [
			{
				"command": "experimentalTunnelTerminal.start",
				"title": "%command.start%",
				"category": "%category%"
			},
			{
				"command": "experimentalTunnelTerminal.copyUrl",
				"title": "%command.copyUrl%",
				"category": "%category%"
			},
			{
				"command": "experimentalTunnelTerminal.copyToken",
				"title": "%command.copyToken%",
				"category": "%category%"
			},
			{
				"command": "experimentalTunnelTerminal.stop",
				"title": "%command.stop%",
				"category": "%category%"
			}
		],
		"menus": {
			"commandPalette": [
				{ "command": "experimentalTunnelTerminal.start", "when": "remoteName && !isWeb" },
				{ "command": "experimentalTunnelTerminal.copyUrl", "when": "remoteName && !isWeb" },
				{ "command": "experimentalTunnelTerminal.copyToken", "when": "remoteName && !isWeb" },
				{ "command": "experimentalTunnelTerminal.stop", "when": "remoteName && !isWeb" }
			]
		}
	},
	"scripts": {
		"check": "tsc --noEmit",
		"build": "node scripts/build.mjs",
		"test": "npm run check && npm run build && node scripts/test.mjs",
		"package": "npm run check && npm run build && vsce package",
		"client": "node dist/client.cjs"
	},
	"dependencies": {
		"node-pty": "1.2.0-beta.15",
		"ws": "8.21.3"
	},
	"devDependencies": {
		"@types/node": "^22.0.0",
		"@types/vscode": "1.95.0",
		"@types/ws": "^8.18.1",
		"@vscode/vsce": "^3.6.0",
		"esbuild": "^0.25.0",
		"typescript": "~5.8.3"
	}
}
