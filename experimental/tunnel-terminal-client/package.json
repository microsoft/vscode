{
	"name": "experimental-tunnel-terminal-client",
	"version": "0.0.1",
	"private": true,
	"description": "An extension-free terminal client for agent-host-capable VS Code tunnels.",
	"license": "MIT",
	"type": "module",
	"bin": {
		"tunnel": "out/src/main.js"
	},
	"engines": {
		"node": ">=22 <23 || >=24 <25"
	},
	"scripts": {
		"postinstall": "node scripts/check-sdk-patch.mjs && patch-package --error-on-fail",
		"build": "tsc",
		"check": "tsc --noEmit",
		"start": "node out/src/main.js",
		"test": "npm run build && node --test --test-timeout=30000 out/test/*.test.js"
	},
	"dependencies": {
		"@microsoft/dev-tunnels-connections": "1.3.56",
		"@microsoft/dev-tunnels-contracts": "1.3.56",
		"@microsoft/dev-tunnels-management": "1.3.56",
		"@microsoft/dev-tunnels-ssh": "3.12.42",
		"patch-package": "8.0.1",
		"ws": "8.21.3"
	},
	"devDependencies": {
		"@types/node": "^22.0.0",
		"@types/ws": "^8.18.1",
		"@xterm/headless": "6.1.0-beta.303",
		"node-pty": "1.2.0-beta.15",
		"typescript": "~5.8.3"
	}
}
