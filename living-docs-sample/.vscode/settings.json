{
	// "Studio" skin: strip the IDE chrome so the workspace reads as a calm word processor.
	// Workspace-scoped on purpose so the experiment is reversible and does not touch global state.
	"workbench.experimental.modernUI": true,
	// The locked Workbench comp has a left icon-nav rail (Documents / Templates / Knowledge /
	// Agents), so the activity bar is shown -- it IS the comp's icon nav -- rather than hidden.
	"workbench.activityBar.location": "default",
	"workbench.editor.showTabs": "none",
	"workbench.editor.editorActionsLocation": "hidden",
	"workbench.layoutControl.enabled": false,
	"workbench.statusBar.visible": false,
	"window.menuBarVisibility": "hidden",
	"window.commandCenter": false,
	"breadcrumbs.enabled": false,
	"editor.minimap.enabled": false,
	"workbench.tips.enabled": false,
	"workbench.startupEditor": "none",
	// The window/title is branded via the config-default in livingDocs.contribution.ts
	// ("${rootName}${separator}Abstract"), so no per-sample override is needed. Do NOT rebrand through
	// product.json applicationName/dataFolderName -- that moves the user-data directory (documented footgun).
	// The registered "Abstract" theme carries the full hi-fi palette (paper, indigo accent,
	// calm grays) so the whole shell matches the design -- not just a handful of accent keys.
	"workbench.colorTheme": "Abstract"
}
