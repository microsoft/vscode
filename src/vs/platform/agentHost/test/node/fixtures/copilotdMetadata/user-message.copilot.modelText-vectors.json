{
  "$comment": "Conformance vectors for the `copilot.modelText` key on Message._meta. See ../user-message.md for the prose spec and ./README.md for the harness contract.",
  "key": "copilot.modelText",
  "carrier": "Message._meta",
  "tests": [
    {
      "name": "set: stamps the key on empty meta",
      "op": "set",
      "input": {
        "message": {
          "text": "/explain foo.rs",
          "origin": {
            "kind": "user"
          }
        },
        "modelText": "Please explain foo.rs in detail."
      },
      "expected": {
        "message": {
          "text": "/explain foo.rs",
          "origin": {
            "kind": "user"
          },
          "_meta": {
            "copilot.modelText": "Please explain foo.rs in detail."
          }
        }
      }
    },
    {
      "name": "set: preserves other _meta keys",
      "op": "set",
      "input": {
        "message": {
          "text": "/explain foo.rs",
          "origin": {
            "kind": "user"
          },
          "_meta": {
            "copilot.unrelated": "keep me"
          }
        },
        "modelText": "expanded"
      },
      "expected": {
        "message": {
          "text": "/explain foo.rs",
          "origin": {
            "kind": "user"
          },
          "_meta": {
            "copilot.unrelated": "keep me",
            "copilot.modelText": "expanded"
          }
        }
      }
    },
    {
      "name": "set: overwrites existing value at the same key",
      "op": "set",
      "input": {
        "message": {
          "text": "/explain foo.rs",
          "origin": {
            "kind": "user"
          },
          "_meta": {
            "copilot.modelText": "first"
          }
        },
        "modelText": "second"
      },
      "expected": {
        "message": {
          "text": "/explain foo.rs",
          "origin": {
            "kind": "user"
          },
          "_meta": {
            "copilot.modelText": "second"
          }
        }
      }
    },
    {
      "name": "extract: returns the value when key present and non-empty",
      "op": "extract",
      "input": {
        "message": {
          "text": "/explain foo.rs",
          "origin": {
            "kind": "user"
          },
          "_meta": {
            "copilot.modelText": "expanded"
          }
        }
      },
      "expected": {
        "modelText": "expanded"
      }
    },
    {
      "name": "extract: returns null when _meta is absent",
      "op": "extract",
      "input": {
        "message": {
          "text": "hello",
          "origin": {
            "kind": "user"
          }
        }
      },
      "expected": {
        "modelText": null
      }
    },
    {
      "name": "extract: returns null when _meta lacks the key",
      "op": "extract",
      "input": {
        "message": {
          "text": "hello",
          "origin": {
            "kind": "user"
          },
          "_meta": {
            "copilot.unrelated": "ignored"
          }
        }
      },
      "expected": {
        "modelText": null
      }
    },
    {
      "name": "extract: returns null when value is the empty string",
      "op": "extract",
      "input": {
        "message": {
          "text": "hello",
          "origin": {
            "kind": "user"
          },
          "_meta": {
            "copilot.modelText": ""
          }
        }
      },
      "expected": {
        "modelText": null
      }
    },
    {
      "name": "extract: returns null when value is a boolean (non-string)",
      "op": "extract",
      "input": {
        "message": {
          "text": "hello",
          "origin": {
            "kind": "user"
          },
          "_meta": {
            "copilot.modelText": true
          }
        }
      },
      "expected": {
        "modelText": null
      }
    },
    {
      "name": "extract: returns null when value is a number (non-string)",
      "op": "extract",
      "input": {
        "message": {
          "text": "hello",
          "origin": {
            "kind": "user"
          },
          "_meta": {
            "copilot.modelText": 42
          }
        }
      },
      "expected": {
        "modelText": null
      }
    },
    {
      "name": "extract: returns null when value is null",
      "op": "extract",
      "input": {
        "message": {
          "text": "hello",
          "origin": {
            "kind": "user"
          },
          "_meta": {
            "copilot.modelText": null
          }
        }
      },
      "expected": {
        "modelText": null
      }
    },
    {
      "name": "extract: returns null when value is a nested object",
      "op": "extract",
      "input": {
        "message": {
          "text": "hello",
          "origin": {
            "kind": "user"
          },
          "_meta": {
            "copilot.modelText": {
              "nested": "object"
            }
          }
        }
      },
      "expected": {
        "modelText": null
      }
    },
    {
      "name": "extract: returns null when value is an array",
      "op": "extract",
      "input": {
        "message": {
          "text": "hello",
          "origin": {
            "kind": "user"
          },
          "_meta": {
            "copilot.modelText": [
              "array"
            ]
          }
        }
      },
      "expected": {
        "modelText": null
      }
    },
    {
      "name": "roundTrip: set then extract preserves text verbatim",
      "op": "roundTrip",
      "input": {
        "message": {
          "text": "/explain foo.rs",
          "origin": {
            "kind": "user"
          }
        },
        "modelText": "<context>\n...\n</context>\n\nWhat does foo do?"
      },
      "expected": {
        "modelText": "<context>\n...\n</context>\n\nWhat does foo do?"
      }
    },
    {
      "name": "wireShape: set then serialize pins the JSON shape",
      "$comment": "Adapters compare the serialized message structurally with `expected.json` \u2014 key order is not significant.",
      "op": "wireShape",
      "input": {
        "message": {
          "text": "/explain foo.rs",
          "origin": {
            "kind": "user"
          }
        },
        "modelText": "model body"
      },
      "expected": {
        "json": {
          "text": "/explain foo.rs",
          "origin": {
            "kind": "user"
          },
          "_meta": {
            "copilot.modelText": "model body"
          }
        }
      }
    },
    {
      "name": "wireShape: no modelText produces a plain text message (no _meta)",
      "op": "wireShape",
      "input": {
        "message": {
          "text": "hello",
          "origin": {
            "kind": "user"
          }
        },
        "modelText": null
      },
      "expected": {
        "json": {
          "text": "hello",
          "origin": {
            "kind": "user"
          }
        }
      }
    }
  ]
}
