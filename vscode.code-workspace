{
	"folders": [
		{
			"path": "."
		}
	],
	"settings": {
		"inlineChat.affordance": "editor",
		"chat.tools.terminal.autoApprove": {
			"scripts/test.bat": true,
			"scripts/test.sh": true,
			"scripts/test-integration.bat": true,
			"scripts/test-integration.sh": true
		},
		"chat.tools.edits.autoApprove": {
			".github/skills/azure-pipelines/azure-pipeline.ts": false
		},
		"chat.editing.explainChanges.enabled": true,
		"files.associations": {
			"cglicenses.json": "jsonc",
			"*.tst": "typescript"
		},
		"js/ts.experimental.useTsgo": true,
		"js/ts.tsdk.path": "node_modules/typescript/lib",
		"js/ts.tsc.autoDetect": "off",
		"git.ignoreLimitWarning": true,
		"git.mergeEditor": true,
		"debug.javascript.terminalOptions": {
			"outFiles": [
				"${workspaceFolder}/out/**/*.js",
				"${workspaceFolder}/build/**/*.js"
			]
		},
		"emmet.excludeLanguages": [],
		"editor.aiStats.enabled": true,
		"debug.breakpointsView.presentation": "tree",
		"chat.agentSkillsLocations": {
			".github/skills/.local": true,
			".agents/skills/.local": true,
			".claude/skills/.local": true
		}
	}
}
