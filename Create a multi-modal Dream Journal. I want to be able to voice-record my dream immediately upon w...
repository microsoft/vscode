l Your Dream\u003c/h2\u003e\\n            \u003cp className\u003d\\\"text-gray-400 text-sm mb-8 italic\\\"\u003eWhisper the details while the fog of sleep still lingers.\u003c/p\u003e\\n\\n            \u003cdiv className\u003d\\\"mb-8 flex flex-col items-center\\\"\u003e\\n              \u003cdiv className\u003d{`relative mb-8`}\u003e\\n                \u003cdiv className\u003d{`absolute inset-0 dream-gradient rounded-full opacity-30 animate-ping ${isRecording ? \u0027block\u0027 : \u0027hidden\u0027}`}\u003e\u003c/div\u003e\\n                \u003cbutton \\n                  onMouseDown\u003d{startRecording}\\n                  onMouseUp\u003d{stopRecording}\\n                  onTouchStart\u003d{startRecording}\\n                  onTouchEnd\u003d{stopRecording}\\n                  className\u003d{`relative z-10 w-24 h-24 rounded-full flex items-center justify-center text-3xl text-white shadow-2xl transition-all ${isRecording ? \u0027bg-pink-600 scale-95\u0027 : \u0027bg-pink-500 hover:scale-105\u0027}`}\\n                \u003e\\n                  \u003ci className\u003d{`fa-solid ${isRecording ? \u0027fa-stop\u0027 : \u0027fa-microphone\u0027}`}\u003e\u003c/i\u003e\\n                \u003c/button\u003e\\n              \u003c/div\u003e\\n              \u003cp className\u003d\\\"text-gray-300 font-medium\\\"\u003e\\n                {isRecording ? \\\"Listening...\\\" : \\\"Hold button to speak\\\"}\\n              \u003c/p\u003e\\n            \u003c/div\u003e\\n\\n            \u003cdiv className\u003d\\\"space-y-4 text-left border-t border-white/10 pt-6\\\"\u003e\\n              \u003clabel className\u003d\\\"text-xs font-bold uppercase tracking-widest text-gray-400 block\\\"\u003eVision Resolution\u003c/label\u003e\\n              \u003cdiv className\u003d\\\"flex space-x-2\\\"\u003e\\n                {([\\\"1K\\\", \\\"2K\\\", \\\"4K\\\"] as ImageResolution[]).map((res) \u003d\u003e (\\n                  \u003cbutton\\n                    key\u003d{res}\\n      