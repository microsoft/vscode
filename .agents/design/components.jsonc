{
	"meta": {
		"version": 3,
		"note": "Source-informed VS Code previews. Production source is canonical. See DESIGN.md for supported interactions and pixel-parity limitations."
	},
	"components": [
		{
			"name": "ButtonPreview",
			"note": "Colophon gallery framing only: 240px maximum, shrinking with the available space. Not a production sizing rule.",
			"root": {
				"id": "button-preview", "el": "div", "attrs": { "style": "width:100%;max-width:240px" },
				"children": [{ "id": "control", "component": "Button" }]
			}
		},
		{
			"name": "SecondaryButtonPreview",
			"note": "Colophon gallery framing only: 240px maximum. The shared control and composed windows retain their original sizing.",
			"root": {
				"id": "secondary-button-preview", "el": "div", "attrs": { "style": "width:100%;max-width:240px" },
				"children": [{ "id": "control", "component": "SecondaryButton" }]
			}
		},
		{
			"name": "DisabledButtonPreview",
			"note": "Colophon gallery framing only: 240px maximum. Native disabled behavior is unchanged.",
			"root": {
				"id": "disabled-button-preview", "el": "div", "attrs": { "style": "width:100%;max-width:240px" },
				"children": [{ "id": "control", "component": "DisabledButton" }]
			}
		},
		{
			"name": "TextInputPreview",
			"note": "Colophon gallery framing only: 400px maximum, shrinking with the available space. Not a production sizing rule.",
			"root": {
				"id": "text-input-preview", "el": "div", "attrs": { "style": "width:100%;max-width:400px" },
				"children": [{ "id": "control", "component": "TextInput" }]
			}
		},
		{
			"name": "SearchFieldPreview",
			"note": "Colophon gallery framing only: 400px maximum. The shared field and composed windows retain their original sizing.",
			"root": {
				"id": "search-field-preview", "el": "div", "attrs": { "style": "width:100%;max-width:400px" },
				"children": [{ "id": "control", "component": "SearchField" }]
			}
		},
		{
			"name": "Typography",
			"note": "src/vs/platform/theme/common/sizes/baseSizes.ts. Windows font preview; no starter classes.",
			"root": {
				"id": "type", "el": "section",
				"layout": { "mode": "vertical", "gap": "12", "padding": "16", "width": "fill" },
				"appearance": { "background": "editor", "color": "foreground", "textStyle": "body1" },
				"children": [
					{ "id": "h1", "el": "span", "appearance": { "textStyle": "heading1" }, "children": ["Heading 1"] },
					{ "id": "h2", "el": "span", "appearance": { "textStyle": "heading2" }, "children": ["Heading 2"] },
					{ "id": "h3", "el": "span", "appearance": { "textStyle": "heading3" }, "children": ["Heading 3"] },
					{ "id": "body1", "el": "span", "children": ["Body 1 · primary content"] },
					{ "id": "body2", "el": "span", "appearance": { "textStyle": "body2", "color": "description" }, "children": ["Body 2 · supporting content"] },
					{ "id": "label1", "el": "span", "appearance": { "textStyle": "label1" }, "children": ["Label 1 · section labels"] },
					{ "id": "label2", "el": "span", "appearance": { "textStyle": "label2" }, "children": ["Label 2 · metadata"] },
					{ "id": "label3", "el": "span", "appearance": { "textStyle": "label3" }, "children": ["Label 3 · badge"] }
				]
			}
		},
		{
			"name": "Separator",
			"note": "One-stroke primitive. Production consumers bind their own semantic border resource.",
			"root": { "id": "separator", "el": "div", "attrs": { "role": "separator" }, "layout": { "width": "fill", "height": 1 }, "appearance": { "background": "border" } }
		},
		{
			"name": "CountBadge",
			"note": "src/vs/base/browser/ui/countBadge. Token-bound badge composition; geometry is not pixel-validated.",
			"props": { "count": "3" },
			"root": {
				"id": "badge", "el": "span",
				"layout": { "mode": "horizontal", "align": "center", "justify": "center", "padding": { "x": "6", "y": "2" }, "width": "hug" },
				"appearance": { "background": "badge", "color": "badgeText", "textStyle": "label2", "radius": "circle" },
				"children": ["{count}"]
			}
		},
		{
			"name": "KeybindingLabel",
			"note": "src/vs/base/browser/ui/keybindingLabel. Static shortcut label, not a registered keybinding.",
			"props": { "keys": "Ctrl+Shift+P" },
			"root": {
				"id": "keybinding", "el": "kbd",
				"layout": { "padding": { "x": "4", "y": "2" }, "width": "hug" },
				"appearance": { "textStyle": "label2", "color": "description", "borderColor": "inputBorder", "borderWidth": 1, "radius": "xSmall" },
				"children": ["{keys}"]
			}
		},
		{
			"name": "Button",
			"note": "src/vs/base/browser/ui/button/button.css: 4px 8px padding, 12px/16px text, 4px radius. Hover/press/focus work; no product command is executed.",
			"props": { "label": "Open Folder" },
			"root": {
				"id": "button", "el": "button", "attrs": { "type": "button" },
				"layout": { "mode": "horizontal", "align": "center", "justify": "center", "padding": { "x": "8", "y": "4" }, "width": "fill" },
				"appearance": { "textStyle": "button", "background": "button", "color": "buttonText", "radius": "control", "borderWidth": 1, "borderColor": "buttonBorder" },
				"control": { "chrome": "none", "focus": { "kind": "outline", "color": "focus" } },
				"states": { "hover": { "background": "buttonHover" }, "pressed": { "background": "buttonHover" }, "disabled": { "background": "secondary", "color": "description" } },
				"transitions": [],
				"children": ["{label}"]
			}
		},
		{
			"name": "SecondaryButton",
			"note": "Secondary button theme roles from src/vs/base/browser/ui/button/button.ts, including its own neutral border. Keyboard focus retains the shared focus indicator.",
			"props": { "label": "Cancel" },
			"root": {
				"id": "secondary", "component": "Button", "props": { "label": "{label}" },
				"appearance": { "background": "secondary", "color": "secondaryText", "borderColor": "secondaryBorder" },
				"states": { "hover": { "background": "secondaryHover" }, "pressed": { "background": "secondaryHover" } }
			}
		},
		{
			"name": "DisabledButton",
			"note": "Native disabled behavior requires an element root: Colophon component instances do not forward attrs. The preview uses a neutral secondary border, not the primary accent. Production uses opacity 0.4; the graph cannot represent that compositing.",
			"root": {
				"id": "disabled", "el": "button", "attrs": { "type": "button", "disabled": true },
				"layout": { "mode": "horizontal", "align": "center", "justify": "center", "padding": { "x": "8", "y": "4" }, "width": "fill" },
				"appearance": { "textStyle": "button", "background": "secondary", "color": "description", "radius": "control", "borderWidth": 1, "borderColor": "secondaryBorder" },
				"control": { "chrome": "none", "focus": { "kind": "outline", "color": "focus" } },
				"children": ["Unavailable"]
			}
		},
		{
			"name": "TextInput",
			"note": "src/vs/base/browser/ui/inputbox/inputBox.css. Shared native field and inset focus stroke for text, search, and command-palette inputs. The focus token follows the 2026 themes.",
			"props": { "label": "File name", "placeholder": "Enter a file name" },
			"root": {
				"id": "input-container", "el": "div",
				"layout": { "width": "fill" },
				"children": [
					{ "id": "input-styles", "el": "style", "children": [
						".vscode-catalog-text-input[data-ds-focus=outline]:focus { outline: 1px solid var(--color-focus); outline-offset: -1px; }\n",
						"@media (forced-colors: active) { .vscode-catalog-text-input[data-ds-focus=outline]:focus { outline-color: Highlight; } }\n"
					] },
					{
						"id": "input", "el": "input", "class": "vscode-catalog-text-input",
						"attrs": { "type": "text", "aria-label": "{label}", "placeholder": "{placeholder}" },
						"layout": { "padding": { "x": "6", "y": "4" }, "width": "fill" },
						"appearance": { "textStyle": "body1", "background": "input", "color": "inputText", "borderColor": "inputBorder", "borderWidth": 1, "radius": "control" },
						"control": { "chrome": "none", "focus": { "kind": "outline", "color": "focus" } }
					}
				]
			}
		},
		{
			"name": "SearchField",
			"note": "Editable search affordance only. No filtering is implied by typing.",
			"root": { "id": "search", "component": "TextInput", "props": { "label": "Search", "placeholder": "Search" } }
		},
		{
			"name": "Checkbox",
			"note": "Native checkbox with a visible, associated label. Browser-native glyph is not VS Code's custom Toggle widget.",
			"props": { "label": "Match Case" },
			"root": {
				"id": "checkbox-label", "el": "label",
				"layout": { "mode": "horizontal", "gap": "6", "align": "center", "width": "hug" },
				"appearance": { "textStyle": "body1", "color": "foreground" },
				"children": [
					{ "id": "checkbox", "el": "input", "attrs": { "type": "checkbox" } },
					"{label}"
				]
			}
		},
		{
			"name": "ToggleSwitch",
			"note": "Instance-local boolean and keyboard behavior. 28x16 track from src/vs/base/browser/ui/toggle/switch.css; container-relative thumb sizing and animation remain production-only.",
			"props": { "label": "Enable Word Wrap" },
			"root": {
				"id": "switch", "el": "button",
				"attrs": { "type": "button", "role": "switch", "aria-label": "{label}" },
				"state": { "checked": false }, "on": { "click": { "toggle": "checked" } },
				"layout": { "mode": "freeform", "width": 28, "height": 16, "padding": "0" },
				"appearance": { "background": "switchTrack", "borderColor": "$none", "borderWidth": 1, "radius": "circle" },
				"control": { "chrome": "none", "focus": { "kind": "outline", "color": "focus" } },
				"states": { "hover": { "borderColor": "focus" } },
				"when": [{ "state": { "checked": true }, "style": { "background": "button", "borderColor": "button" } }],
				"transitions": [],
				"children": [{
					"id": "thumb", "el": "span", "attrs": { "aria-hidden": "true" },
					"position": { "mode": "absolute", "x": 1, "y": 1 },
					"layout": { "width": 12, "height": 12 },
					"appearance": { "background": "buttonText", "radius": "circle" },
					"when": [{ "state": { "checked": true }, "style": { "geometry": { "translateX": 12 } } }]
				}]
			}
		},
		{
			"name": "SelectBox",
			"note": "src/vs/base/browser/ui/selectBox has native and custom variants. This uses a working native select, not a replica of the custom popup.",
			"root": {
				"id": "select", "el": "select", "attrs": { "aria-label": "Line Ending" },
				"layout": { "padding": { "x": "6", "y": "4" }, "width": "fill" },
				"appearance": { "textStyle": "body1", "background": "input", "color": "inputText", "borderColor": "inputBorder", "borderWidth": 1, "radius": "control" },
				"children": [
					{ "id": "lf", "el": "option", "attrs": { "value": "lf" }, "children": ["LF"] },
					{ "id": "crlf", "el": "option", "attrs": { "value": "crlf" }, "children": ["CRLF"] }
				]
			}
		},
		{
			"name": "Picker",
			"note": "Opens PickerOptions. Escape dismisses and restores focus. Selection is transient and does not change this label.",
			"props": { "label": "Mode" },
			"root": {
				"id": "picker", "component": "SecondaryButton", "props": { "label": "{label}" },
				"layout": { "width": "hug" },
				"on": { "click": { "open": "PickerOptions" } }
			}
		},
		{
			"name": "PickerOptions",
			"note": "Isolated radio group in a dismissible flyout. Options are sample data, not a provider capability list.",
			"root": {
				"id": "options", "el": "div", "attrs": { "role": "group", "aria-label": "Mode" },
				"layout": { "mode": "vertical", "gap": "8", "padding": "8", "width": 200 },
				"appearance": { "background": "quickInput", "color": "foreground", "textStyle": "body1", "radius": "outer", "borderColor": "border", "borderWidth": 1 },
				"children": [
					{ "id": "ask", "el": "label", "layout": { "mode": "horizontal", "gap": "6", "align": "center" }, "children": [{ "id": "ask-input", "el": "input", "attrs": { "type": "radio", "name": "mode", "value": "ask", "checked": true } }, "Ask"] },
					{ "id": "edit", "el": "label", "layout": { "mode": "horizontal", "gap": "6", "align": "center" }, "children": [{ "id": "edit-input", "el": "input", "attrs": { "type": "radio", "name": "mode", "value": "edit" } }, "Edit"] },
					{ "id": "agent", "el": "label", "layout": { "mode": "horizontal", "gap": "6", "align": "center" }, "children": [{ "id": "agent-input", "el": "input", "attrs": { "type": "radio", "name": "mode", "value": "agent" } }, "Agent"] }
				]
			}
		},
		{
			"name": "Toolbar",
			"note": "src/vs/base/browser/ui/toolbar. Composition study; buttons demonstrate focus and picker activation, not ActionBar roving focus.",
			"root": {
				"id": "toolbar", "el": "div", "attrs": { "role": "group", "aria-label": "Editor Actions" },
				"layout": { "mode": "horizontal", "gap": "4", "align": "center", "width": "hug" },
				"children": [
					{ "id": "mode", "component": "Picker" },
					{ "id": "more", "component": "Picker", "props": { "label": "More Actions" } }
				]
			}
		},
		{
			"name": "FindWidget",
			"note": "src/vs/base/browser/ui/findinput. Editable query and native toggles; no editor search or match count computation.",
			"root": {
				"id": "find", "el": "section", "attrs": { "aria-label": "Find Preview" },
				"layout": { "mode": "vertical", "gap": "8", "padding": "8", "width": "fill" },
				"appearance": { "background": "editor", "color": "foreground", "radius": "outer", "borderColor": "border", "borderWidth": 1 },
				"children": [
					{ "id": "query", "component": "TextInput", "props": { "label": "Find", "placeholder": "Find" } },
					{ "id": "flags", "el": "div", "layout": { "mode": "horizontal", "gap": "12", "wrap": true }, "children": [
						{ "id": "case", "component": "Checkbox" },
						{ "id": "word", "component": "Checkbox", "props": { "label": "Match Whole Word" } },
						{ "id": "regex", "component": "Checkbox", "props": { "label": "Use Regular Expression" } }
					] }
				]
			}
		},
		{
			"name": "CommandCenter",
			"note": "src/vs/workbench/browser/parts/titlebar. Opens a command-palette preview; does not execute a product command.",
			"root": {
				"id": "command-center", "component": "SecondaryButton", "props": { "label": "vscode" },
				"layout": { "width": 320, "height": 28 },
				"on": { "click": { "open": "CommandPalette" } }
			}
		},
		{
			"name": "CommandRow",
			"note": "Preview-only command selection with native radio arrow keys. The palette overrides generic row selection with quickInputList focus colors. Choosing a result in the command-center flyout dismisses it; no product command runs.",
			"props": { "label": "View: Toggle Terminal" },
			"root": {
				"id": "command-row", "el": "label", "attrs": { "class": "vscode-catalog-selectable-row vscode-catalog-command-row" },
				"layout": { "mode": "horizontal", "align": "center", "padding": "6", "width": "fill" },
				"appearance": { "textStyle": "body1", "radius": "control" },
				"children": [
					{ "id": "styles", "component": "SelectableRowStyles" },
					{ "id": "selection", "el": "input", "attrs": { "type": "radio", "class": "vscode-catalog-row-input", "name": "command-result-preview", "value": "{label}", "aria-label": "{label}" } },
					{ "id": "label", "el": "span", "children": ["{label}"] }
				]
			}
		},
		{
			"name": "CommandPalette",
			"note": "src/vs/platform/quickinput/browser. Editable field and exclusively selectable sample results with pointer/arrow-key interaction. Flyout selection or Escape dismisses and restores trigger focus. No filtering, command execution, or modal focus trap.",
			"root": {
				"id": "palette", "el": "section", "attrs": { "class": "vscode-catalog-command-palette", "aria-label": "Command Palette Preview" },
				"layout": { "mode": "vertical", "gap": "8", "padding": "8", "width": 440 },
				"appearance": { "background": "quickInput", "color": "foreground", "textStyle": "body1", "radius": "outer", "borderColor": "border", "borderWidth": 1 },
				"children": [
					{ "id": "palette-styles", "el": "style", "children": [
						".vscode-catalog-command-palette .vscode-catalog-command-row.vscode-catalog-selectable-row:has(.vscode-catalog-row-input:checked) { background: var(--color-quickInputSelection); color: var(--color-quickInputSelectionText); }\n",
						"@media (forced-colors: active) { .vscode-catalog-command-palette .vscode-catalog-command-row:has(.vscode-catalog-row-input:checked) { outline: 1px solid Highlight; outline-offset: -1px; } }\n"
					] },
					{ "id": "command-input", "component": "TextInput", "props": { "label": "Command", "placeholder": "Type the name of a command to run" } },
					{ "id": "results", "el": "div", "attrs": { "role": "radiogroup", "aria-label": "Sample Commands" }, "layout": { "mode": "vertical", "gap": "4" }, "children": [
						{ "id": "terminal", "component": "CommandRow", "props": { "label": "View: Toggle Terminal" } },
						{ "id": "theme", "component": "CommandRow", "props": { "label": "Preferences: Color Theme" } },
						{ "id": "folder", "component": "CommandRow", "props": { "label": "File: Open Folder..." } }
					] },
					{ "id": "limit", "el": "span", "appearance": { "textStyle": "body2", "color": "description" }, "children": ["Select a sample command · no command runs · Escape closes the flyout"] }
				]
			}
		},
		{
			"name": "WorkbenchPreviewStyles",
			"note": "Colophon-only styles for the classic Explorer and connected modern editor tabs. Seti WOFF is embedded verbatim from extensions/theme-seti/icons/seti.woff; see DESIGN.md for asset attribution. Never port these preview selectors into production.",
			"root": {
				"id": "workbench-preview-styles", "el": "style",
				"children": [
					"/* Microsoft Codicons 0.0.46-49: https://github.com/microsoft/vscode-codicons, CC BY 4.0, https://creativecommons.org/licenses/by/4.0/. Chevron-down and close vectors are unmodified. Seti UI: Copyright (c) 2014 Jesse Weed. Permission is hereby granted, free of charge, to any person obtaining a copy of this software and associated documentation files (the Software), to deal in the Software without restriction, including without limitation the rights to use, copy, modify, merge, publish, distribute, sublicense, and/or sell copies of the Software, and to permit persons to whom the Software is furnished to do so, subject to the following conditions: The above copyright notice and this permission notice shall be included in all copies or substantial portions of the Software. THE SOFTWARE IS PROVIDED AS IS, WITHOUT WARRANTY OF ANY KIND, EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY, FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE SOFTWARE. */\n",
					"@font-face { font-family: vscode-catalog-seti; src: url(data:font/woff;base64,) format('woff'); font-weight: normal; font-style: normal; font-display: block; }\n",
					".vscode-catalog-explorer, .vscode-catalog-tabs { font-family: var(--text-body1-family); font-size: var(--text-body1-size); font-weight: 400; }\n",
					".vscode-catalog-explorer { width: 220px; height: 100%; flex-shrink: 0; background: var(--color-chrome); color: var(--color-foreground); border-right: 1px solid var(--color-border); box-sizing: border-box; }\n",
					".vscode-catalog-explorer-title { display: flex; align-items: center; height: 35px; padding: 0 20px; font-size: 11px; font-weight: 400; }\n",
					".vscode-catalog-explorer details { margin: 0; padding: 0; }\n",
					".vscode-catalog-explorer summary, .vscode-catalog-folder > summary { list-style: none; display: flex; align-items: center; white-space: nowrap; cursor: pointer; }\n",
					".vscode-catalog-explorer summary::-webkit-details-marker, .vscode-catalog-folder > summary::-webkit-details-marker { display: none; }\n",
					".vscode-catalog-section > summary { height: 22px; line-height: 22px; font-size: 11px; font-weight: 700; background: var(--color-sectionHeader); color: var(--color-sectionHeaderText); }\n",
					".vscode-catalog-section + .vscode-catalog-section > summary { border-top: 1px solid var(--color-sectionHeaderBorder); box-sizing: border-box; }\n",
					".vscode-catalog-section > summary > svg { flex: 0 0 16px; margin: 0 2px; transform: rotate(-90deg); }\n",
					".vscode-catalog-section[open] > summary > svg { transform: translateY(1px); }\n",
					".vscode-catalog-folder > summary, .vscode-catalog-file-row { height: 22px; line-height: 22px; font-size: 13px; font-weight: 400; }\n",
					"body[data-ds-theme=highContrast] .vscode-catalog-folder > summary, body[data-ds-theme=highContrast] .vscode-catalog-file-row { line-height: 20px; }\n",
					".vscode-catalog-folder > summary { padding-left: 8px; }\n",
					".vscode-catalog-folder > summary > svg { flex: 0 0 16px; width: 16px; height: 16px; padding: 0; margin-right: 6px; transform-origin: center; transform: translateX(3px) rotate(-90deg); }\n",
					".vscode-catalog-folder[open] > summary > svg { transform: translateX(3px); }\n",
					".vscode-catalog-folder-label { display: flex; align-items: center; align-self: stretch; flex: 1; min-width: 0; cursor: pointer; }\n",
					".vscode-catalog-file-row { display: flex; align-items: center; padding-left: 30px; white-space: nowrap; }\n",
					".vscode-catalog-folder > .vscode-catalog-file-row { padding-left: 38px; }\n",
					".vscode-catalog-folder > summary:hover, .vscode-catalog-file-row:hover { background: var(--color-listHover); }\n",
					".vscode-catalog-explorer summary:focus-visible { outline: 1px solid var(--color-focus); outline-offset: -1px; }\n",
					".vscode-catalog-file-icon { display: inline-block; flex: 0 0 22px; width: 22px; height: 22px; line-height: inherit; font-family: vscode-catalog-seti; font-size: 150%; font-weight: normal; font-style: normal; color: var(--color-setiBlue); -webkit-font-smoothing: antialiased; }\n",
					".vscode-catalog-file-icon[data-icon=typescript]::before { content: '\\e099'; }\n",
					".vscode-catalog-file-icon[data-icon=readme]::before { content: '\\e04d'; }\n",
					".vscode-catalog-file-icon[data-icon=json]::before { content: '\\e055'; color: var(--color-setiYellow); }\n",
					".vscode-catalog-file-icon[data-icon=javascript]::before { content: '\\e051'; color: var(--color-setiYellow); }\n",
					".vscode-catalog-tabs { display: flex; align-items: flex-end; height: 32px; flex-shrink: 0; overflow-x: auto; background: var(--color-tabStrip); box-shadow: inset 0 -1px var(--color-tabStripBorder); }\n",
					".vscode-catalog-tab { position: relative; flex-shrink: 0; cursor: pointer; }\n",
					".vscode-catalog-tab-input { position: absolute; width: 1px; height: 1px; margin: 0; clip-path: inset(50%); overflow: hidden; }\n",
					".vscode-catalog-tab-face { position: relative; display: flex; align-items: center; box-sizing: border-box; min-width: 120px; height: 28px; padding-left: var(--space-6); white-space: nowrap; background: transparent; color: var(--color-tabText); border: 1px solid transparent; border-bottom: 0; border-radius: var(--radius-control); }\n",
					".vscode-catalog-tab-face > .vscode-catalog-file-icon { position: relative; z-index: 1; height: 27px; line-height: 27px; }\n",
					".vscode-catalog-tab-name { position: relative; z-index: 1; flex: 1; }\n",
					".vscode-catalog-tab-preview .vscode-catalog-tab-name { font-style: italic; padding-right: 1px; }\n",
					".vscode-catalog-tab-close { position: relative; z-index: 1; display: flex; align-items: center; justify-content: center; width: 28px; flex: 0 0 28px; opacity: 0; }\n",
					".vscode-catalog-tab-edge { display: none; position: absolute; inset: -1px -1px 0; border: 1px solid var(--color-tabStripBorder); border-bottom: 0; border-radius: calc(var(--radius-inner) + 1px) calc(var(--radius-inner) + 1px) 0 0; clip-path: inset(0 0 calc(var(--radius-inner) + 1px)); pointer-events: none; }\n",
					".vscode-catalog-tab:hover > .vscode-catalog-tab-face { background: color-mix(in srgb, var(--color-foreground) 6%, var(--color-tabStrip)); }\n",
					".vscode-catalog-tab-input:checked + .vscode-catalog-tab-face { z-index: 1; background: var(--color-editor); color: var(--color-tabActiveText); border-radius: calc(var(--radius-inner) + 1px) calc(var(--radius-inner) + 1px) 0 0; }\n",
					".vscode-catalog-tab-input:checked + .vscode-catalog-tab-face > .vscode-catalog-tab-edge { display: block; }\n",
					".vscode-catalog-tab-input:checked + .vscode-catalog-tab-face::before, .vscode-catalog-tab-input:checked + .vscode-catalog-tab-face::after { content: ''; position: absolute; bottom: 0; width: calc(var(--radius-inner) + 1px); height: calc(var(--radius-inner) + 1px); box-sizing: border-box; border-bottom: 1px solid var(--color-tabStripBorder); clip-path: inset(0); pointer-events: none; }\n",
					".vscode-catalog-tab-input:checked + .vscode-catalog-tab-face::before { right: 100%; border-right: 1px solid var(--color-tabStripBorder); border-bottom-right-radius: calc(var(--radius-inner) + 1px); box-shadow: calc((var(--radius-inner) + 1px) / 2) calc((var(--radius-inner) + 1px) / 2) 0 calc((var(--radius-inner) + 1px) / 2) var(--color-editor); }\n",
					".vscode-catalog-tab-input:checked + .vscode-catalog-tab-face::after { left: 100%; border-left: 1px solid var(--color-tabStripBorder); border-bottom-left-radius: calc(var(--radius-inner) + 1px); box-shadow: calc((var(--radius-inner) + 1px) / -2) calc((var(--radius-inner) + 1px) / 2) 0 calc((var(--radius-inner) + 1px) / 2) var(--color-editor); }\n",
					".vscode-catalog-tab:first-of-type > .vscode-catalog-tab-input:checked + .vscode-catalog-tab-face::before { content: none; }\n",
					".vscode-catalog-tab:hover .vscode-catalog-tab-close, .vscode-catalog-tab-input:checked + .vscode-catalog-tab-face .vscode-catalog-tab-close, .vscode-catalog-tab-input:focus-visible + .vscode-catalog-tab-face .vscode-catalog-tab-close { opacity: 1; }\n",
					".vscode-catalog-tab-input:focus-visible + .vscode-catalog-tab-face { outline: 1px solid var(--color-focus); outline-offset: -2px; }\n",
					"body[data-ds-theme=highContrast] .vscode-catalog-tab-input:checked + .vscode-catalog-tab-face { outline: 1px solid var(--color-activeContrast); outline-offset: -5px; }\n",
					"body[data-ds-theme=highContrast] .vscode-catalog-tab:hover > .vscode-catalog-tab-input:not(:checked) + .vscode-catalog-tab-face, body[data-ds-theme=highContrast] .vscode-catalog-tab-input:checked:focus-visible + .vscode-catalog-tab-face { outline: 1px dashed var(--color-activeContrast); outline-offset: -5px; }\n"
				]
			}
		},
		{
			"name": "SelectableRowStyles",
			"note": "Preview-only shared radio selection, hover, and keyboard focus. Selection uses listColors.ts resources, including transparent high-contrast fills with explicit outlines.",
			"root": {
				"id": "row-styles", "el": "style",
				"children": [
					".vscode-catalog-row-input { position: absolute; width: 1px; height: 1px; margin: 0; clip-path: inset(50%); overflow: hidden; }\n",
					".vscode-catalog-selectable-row { position: relative; cursor: pointer; color: var(--color-foreground); }\n",
					".vscode-catalog-selectable-row:hover { background: var(--color-listHover); }\n",
					".vscode-catalog-selectable-row:has(.vscode-catalog-row-input:checked) { background: var(--color-listSelectionInactive); color: var(--color-foreground); }\n",
					".vscode-catalog-selectable-row:has(.vscode-catalog-row-input:checked):focus-within { background: var(--color-listSelection); color: var(--color-listSelectionText); }\n",
					"body[data-ds-theme=highContrast] .vscode-catalog-selectable-row:has(.vscode-catalog-row-input:checked) { outline: 1px solid var(--color-activeContrast); outline-offset: -1px; }\n",
					".vscode-catalog-selectable-row:has(.vscode-catalog-row-input:focus-visible) { outline: 1px solid var(--color-focus); outline-offset: -1px; }\n",
					".vscode-catalog-session-detail { color: var(--color-description); }\n",
					".vscode-catalog-selectable-row:has(.vscode-catalog-row-input:checked):focus-within .vscode-catalog-session-detail { color: inherit; }\n",
					".vscode-catalog-sessions-group { margin: 0; padding: 0; }\n",
					".vscode-catalog-sessions-group > summary { display: flex; align-items: center; gap: var(--space-4); list-style: none; cursor: pointer; }\n",
					".vscode-catalog-sessions-group > summary::-webkit-details-marker { display: none; }\n",
					".vscode-catalog-sessions-group > summary > svg { transform: rotate(-90deg); }\n",
					".vscode-catalog-sessions-group[open] > summary > svg { transform: none; }\n",
					".vscode-catalog-sessions-group > summary:focus-visible { outline: 1px solid var(--color-focus); outline-offset: -1px; }\n"
				]
			}
		},
