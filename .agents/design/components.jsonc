						".vscode-catalog-composer-action { min-width: 22px; white-space: nowrap; cursor: pointer; }\n",
						".vscode-catalog-composer-action > svg { flex-shrink: 0; }\n",
						".vscode-catalog-composer-action > span:empty, .vscode-catalog-composer-action > svg:has(path[d='']) { display: none; }\n",
						".vscode-catalog-composer-action[aria-expanded=true] { background: var(--color-listHover) !important; }\n",
						".vscode-catalog-composer-action:focus-visible { outline: 1px solid var(--color-focus); outline-offset: -1px; }\n",
						".vscode-catalog-composer-attachment { font-style: italic; border: 1px dashed var(--color-inputBorder) !important; }\n",
						"@media (forced-colors: active) { .vscode-catalog-composer-input:focus-within { border-color: Highlight !important; } .vscode-catalog-composer-action:focus-visible { outline-color: Highlight; } }\n"
					] },
