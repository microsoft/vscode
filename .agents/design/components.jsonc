		{
			"name": "Conversation",
			"note": "src/vs/workbench/contrib/chat. Static trusted sample text; no model-authored markdown, streaming, or tool execution.",
			"root": {
				"id": "conversation", "el": "section", "attrs": { "aria-label": "Conversation Preview" },
				"layout": { "mode": "vertical", "gap": "20", "padding": "20", "width": "fill", "height": "fill", "justify": "space-between" },
				"appearance": { "background": "agentsPanel", "color": "foreground", "textStyle": "body1", "radius": "outer" },
				"children": [
					{ "id": "content", "el": "div", "layout": { "mode": "vertical", "gap": "16" }, "children": [
						{ "id": "title", "el": "span", "appearance": { "textStyle": "heading3" }, "children": ["Review changes"] },
						{ "id": "request", "el": "span", "children": ["Explain the component hierarchy."] },
						{ "id": "response", "el": "span", "children": ["Shared controls compose into workbench parts. The Agents Window uses a separate sessions layout with a conversation and details side pane."] },
						{ "id": "disclaimer", "el": "span", "appearance": { "textStyle": "body2", "color": "description" }, "children": ["Static sample conversation"] }
					] },
					{ "id": "composer", "component": "Composer" }
				]
			}
		},
		{
			"name": "ChangedFileRow",
			"note": "Preview-only file selection with native radio arrow keys and shared themed selection/focus styling. Does not open a diff or modify files.",
			"props": { "label": "DESIGN.md" },
			"root": {
				"id": "changed-file", "el": "label", "class": "vscode-catalog-selectable-row",
				"layout": { "mode": "horizontal", "align": "center", "padding": "8", "width": "fill" },
				"appearance": { "textStyle": "body1", "radius": "control" },
				"children": [
					{ "id": "styles", "component": "SelectableRowStyles" },
					{ "id": "selection", "el": "input", "class": "vscode-catalog-row-input", "attrs": { "type": "radio", "name": "changes-file-preview", "value": "{label}", "aria-label": "{label}" } },
					{ "id": "name", "el": "span", "children": ["{label}"] }
				]
			}
		},
		{
			"name": "ChangesPanel",
			"note": "src/vs/sessions/contrib/changes. Exclusive sample file selection with pointer and native radio arrow keys. Selection does not open a diff or modify files.",
			"root": {
				"id": "changes", "el": "aside", "attrs": { "aria-label": "Changes Preview" },
				"layout": { "mode": "vertical", "gap": "12", "padding": "12", "width": 220, "height": "fill" },
				"appearance": { "background": "agentsPanel", "color": "foreground", "textStyle": "body1", "radius": "outer" },
				"children": [
					{ "id": "title", "el": "div", "layout": { "mode": "horizontal", "justify": "space-between", "align": "center" }, "children": ["Changes", { "id": "count", "component": "CountBadge", "props": { "count": "2" } }] },
					{ "id": "separator", "component": "Separator" },
					{ "id": "files", "el": "div", "attrs": { "role": "group", "aria-label": "Changed Files" }, "layout": { "mode": "vertical", "gap": "4" }, "children": [
						{ "id": "design-file", "component": "ChangedFileRow" },
						{ "id": "components-file", "component": "ChangedFileRow", "props": { "label": "components.jsonc" } }
					] },
					{ "id": "note", "el": "span", "appearance": { "textStyle": "body2", "color": "description" }, "children": ["Select a sample file · no diff is opened"] }
				]
			}
		}
	]
}
