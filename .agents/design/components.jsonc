				"children": [
					{ "id": "title", "el": "span", "appearance": { "textStyle": "heading3" }, "children": ["{title}"] },
					{ "id": "options", "el": "div", "attrs": { "role": "radiogroup", "aria-label": "{title}" }, "layout": { "mode": "vertical", "gap": "8" }, "children": [
						{ "id": "first", "el": "label", "layout": { "mode": "horizontal", "gap": "6", "align": "center" }, "children": [{ "id": "first-input", "el": "input", "attrs": { "type": "radio", "name": "{title}", "value": "{first}" } }, "{first}"] },
						{ "id": "second", "el": "label", "layout": { "mode": "horizontal", "gap": "6", "align": "center" }, "children": [{ "id": "second-input", "el": "input", "attrs": { "type": "radio", "name": "{title}", "value": "{second}" } }, "{second}"] },
						{ "id": "third", "el": "label", "layout": { "mode": "horizontal", "gap": "6", "align": "center" }, "children": [{ "id": "third-input", "el": "input", "attrs": { "type": "radio", "name": "{title}", "value": "{third}" } }, "{third}"] }
					] },
					{ "id": "limit", "el": "span", "appearance": { "textStyle": "body2", "color": "description" }, "children": ["Preview only - selection does not change settings or add context. Escape returns to the composer."] }
				]
			}
		},
		{
			"name": "ComposerAttachmentOptions",
			"root": { "id": "attachments", "component": "ComposerOptions", "props": { "title": "Add Context Preview", "first": "Files...", "second": "Editor Selection", "third": "Screenshot" } }
		},
		{
			"name": "ComposerModelOptions",
			"root": { "id": "models", "component": "ComposerOptions", "props": { "title": "Sample Models", "first": "Auto (Sample)", "second": "Model A (Sample)", "third": "Model B (Sample)" } }
		},
		{
			"name": "ComposerInteractionOptions",
			"root": { "id": "interaction", "component": "ComposerOptions", "props": { "title": "Interaction Preview", "first": "Interactive", "second": "Plan", "third": "Autopilot" } }
		},
		{
			"name": "ComposerPermissionOptions",
			"root": { "id": "permissions", "component": "ComposerOptions", "props": { "title": "Sample Permissions", "first": "Manual Permissions", "second": "Ask Before Actions", "third": "Read Only" } }
		},
		{
			"name": "ComposerActionNotice",
			"props": { "title": "Composer Preview", "message": "No action is performed." },
			"root": {
				"id": "composer-notice", "el": "section", "attrs": { "aria-label": "{title}" },
				"layout": { "mode": "vertical", "gap": "8", "padding": "12", "width": 260 },
				"appearance": { "background": "quickInput", "color": "foreground", "textStyle": "body1", "radius": "outer", "borderColor": "border", "borderWidth": 1 },
				"children": [
					{ "id": "title", "el": "span", "appearance": { "textStyle": "heading3" }, "children": ["{title}"] },
					{ "id": "message", "el": "span", "children": ["{message}"] },
					{ "id": "close-hint", "el": "span", "appearance": { "textStyle": "body2", "color": "description" }, "children": ["Escape closes this preview and returns focus."] }
				]
			}
		},
		{
			"name": "ComposerFilePreview",
			"root": { "id": "file", "component": "ComposerActionNotice", "props": { "title": "npmprofile.mjs", "message": "Sample file context only. No local file is read or attached." } }
		},
		{
			"name": "ComposerDictationPreview",
			"root": { "id": "dictation", "component": "ComposerActionNotice", "props": { "title": "Dictation Preview", "message": "The microphone button is a local interaction preview. It does not record audio or request microphone access." } }
		},
		{
			"name": "ComposerVoicePreview",
			"root": { "id": "voice", "component": "ComposerActionNotice", "props": { "title": "Voice Mode Preview", "message": "Voice mode is a local interaction preview. No audio is recorded, played, or sent." } }
		},
		{
			"name": "ComposerSendPreview",
			"root": { "id": "send", "component": "ComposerActionNotice", "props": { "title": "Send Preview", "message": "Nothing was sent. Your draft stays in the composer; this catalog does not contact an agent or execute a command." } }
		},
		{
			"name": "ComposerConnectionPreview",
			"root": { "id": "connection", "component": "ComposerActionNotice", "props": { "title": "Connection Preview", "message": "Local preview only. No remote connection is opened." } }
		},
