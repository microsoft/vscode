{
  "name": "vscode-json-languageserver",
  "description": "JSON language server",
  "version": "1.3.4",
  "author": "Microsoft Corporation",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "*"
  },
  "bin": {
    "vscode-json-languageserver": "./bin/vscode-json-languageserver"
  },
  "main": "./out/node/jsonServerMain",
  "dependencies": {
    "@vscode/l10n": "^0.0.18",
    "request-light": "^0.8.0",
    "vscode-json-languageservice": "^6.0.0-next.4",
    "vscode-languageserver": "^10.1.1",
    "vscode-uri": "^3.1.0"
  },
  "devDependencies": {
    "@types/node": "24.x"
  },
  "scripts": {
    "prepublishOnly": "pnpm run clean && pnpm run compile",
    "compile": "pnpm exec gulp compile-extension:json-language-features-server",
    "watch": "pnpm exec gulp watch-extension:json-language-features-server",
    "clean": "../../../node_modules/.bin/rimraf out",
    "install-service-next": "pnpm add vscode-json-languageservice@next",
    "install-service-latest": "pnpm add vscode-json-languageservice",
    "install-service-local": "pnpm link ../../../../vscode-json-languageservice",
    "install-server-next": "pnpm add vscode-languageserver@next",
    "install-server-local": "pnpm link ../../../../vscode-languageserver-node/server",
    "version": "git commit -m \"JSON Language Server $npm_package_version\" package.json"
  }
}
