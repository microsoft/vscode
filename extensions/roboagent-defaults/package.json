{
	"name": "roboagent-defaults",
	"displayName": "RoboAgent Default Configurations",
	"description": "Provides default build tasks, launch configurations, toolbar buttons, and status bar items for C++, CMake, Python, and ROS2 in RoboAgent",
	"version": "1.0.0",
	"publisher": "roboagent",
	"license": "MIT",
	"engines": {
		"vscode": "^1.120.0"
	},
	"categories": [
		"Debuggers",
		"Programming Languages"
	],
	"activationEvents": [
		"onLanguage:cpp",
		"onLanguage:c",
		"onLanguage:python",
		"onLanguage:cmake",
		"workspaceContains:**/CMakeLists.txt",
		"workspaceContains:**/package.xml"
	],
	"main": "./dist/extension.js",
	"contributes": {
		"commands": [
			{
				"command": "roboagent.buildFile",
				"title": "Build Active File",
				"category": "RoboAgent",
				"icon": "$(tools)"
			},
			{
				"command": "roboagent.runFile",
				"title": "Run Active File",
				"category": "RoboAgent",
				"icon": "$(play)"
			},
			{
				"command": "roboagent.cmakeConfigure",
				"title": "CMake: Configure",
				"category": "RoboAgent",
				"icon": "$(gear)"
			},
			{
				"command": "roboagent.cmakeBuild",
				"title": "CMake: Build",
				"category": "RoboAgent",
				"icon": "$(tools)"
			},
			{
				"command": "roboagent.cmakeRun",
				"title": "CMake: Build & Run",
				"category": "RoboAgent",
				"icon": "$(play)"
			},
			{
				"command": "roboagent.cmakeClean",
				"title": "CMake: Clean",
				"category": "RoboAgent",
				"icon": "$(trash)"
			},
			{
				"command": "roboagent.colconBuild",
				"title": "Colcon: Build Workspace",
				"category": "RoboAgent",
				"icon": "$(package)"
			}
		],
		"menus": {
			"editor/title/run": [
				{
					"command": "roboagent.runFile",
					"when": "resourceLangId == cpp || resourceLangId == c",
					"group": "1_run@1"
				},
				{
					"command": "roboagent.cmakeRun",
					"when": "roboagent.isCMakeProject && (resourceLangId == cpp || resourceLangId == c || resourceLangId == cmake)",
					"group": "1_run@2"
				},
				{
					"command": "roboagent.runFile",
					"when": "resourceLangId == python",
					"group": "1_run@3"
				}
			],
			"editor/title": [
				{
					"command": "roboagent.cmakeBuild",
					"when": "roboagent.isCMakeProject && (resourceLangId == cpp || resourceLangId == c || resourceLangId == cmake)",
					"group": "navigation@1"
				},
				{
					"command": "roboagent.cmakeRun",
					"when": "roboagent.isCMakeProject && (resourceLangId == cpp || resourceLangId == c || resourceLangId == cmake)",
					"group": "navigation@2"
				}
			]
		},
		"taskDefinitions": [
			{
				"type": "roboagent-cpp",
				"required": [],
				"properties": {}
			},
			{
				"type": "roboagent-cmake",
				"required": [],
				"properties": {}
			}
		],
		"debuggers": [
			{
				"type": "roboagent-cppdbg",
				"label": "RoboAgent: C/C++ (GDB)",
				"configurationAttributes": {
					"launch": {
						"properties": {
							"program": {
								"type": "string",
								"description": "Path to the executable"
							},
							"args": {
								"type": "array",
								"description": "Program arguments"
							},
							"cwd": {
								"type": "string",
								"description": "Working directory"
							}
						}
					}
				},
				"initialConfigurations": [
					{
						"name": "C/C++: Build & Run active file",
						"type": "cppdbg",
						"request": "launch",
						"program": "${fileDirname}/${fileBasenameNoExtension}",
						"args": [],
						"stopAtEntry": false,
						"cwd": "${fileDirname}",
						"environment": [],
						"externalConsole": false,
						"MIMode": "gdb",
						"setupCommands": [
							{
								"description": "Enable pretty-printing for gdb",
								"text": "-enable-pretty-printing",
								"ignoreFailures": true
							}
						],
						"preLaunchTask": "RoboAgent: g++ build active file",
						"miDebuggerPath": "/usr/bin/gdb"
					}
				],
				"configurationSnippets": [
					{
						"label": "RoboAgent: C/C++ Build & Run",
						"description": "Build and run the active C/C++ file with g++ and GDB",
						"body": {
							"name": "C/C++: Build & Run active file",
							"type": "cppdbg",
							"request": "launch",
							"program": "^\"\\${fileDirname}/\\${fileBasenameNoExtension}\"",
							"args": [],
							"stopAtEntry": false,
							"cwd": "^\"\\${fileDirname}\"",
							"environment": [],
							"externalConsole": false,
							"MIMode": "gdb",
							"setupCommands": [
								{
									"description": "Enable pretty-printing for gdb",
									"text": "-enable-pretty-printing",
									"ignoreFailures": true
								}
							],
							"preLaunchTask": "RoboAgent: g++ build active file",
							"miDebuggerPath": "/usr/bin/gdb"
						}
					},
					{
						"label": "RoboAgent: CMake Build & Debug",
						"description": "Configure, build, and debug a CMake project with GDB",
						"body": {
							"name": "CMake: Build & Debug",
							"type": "cppdbg",
							"request": "launch",
							"program": "^\"\\${workspaceFolder}/build/\\${workspaceFolderBasename}\"",
							"args": [],
							"stopAtEntry": false,
							"cwd": "^\"\\${workspaceFolder}\"",
							"environment": [],
							"externalConsole": false,
							"MIMode": "gdb",
							"setupCommands": [
								{
									"description": "Enable pretty-printing for gdb",
									"text": "-enable-pretty-printing",
									"ignoreFailures": true
								}
							],
							"preLaunchTask": "RoboAgent: CMake build",
							"miDebuggerPath": "/usr/bin/gdb"
						}
					},
					{
						"label": "RoboAgent: ROS2 Node Debug",
						"description": "Debug a ROS2 node executable with GDB",
						"body": {
							"name": "ROS2: Debug ${1:node_name}",
							"type": "cppdbg",
							"request": "launch",
							"program": "^\"\\${workspaceFolder}/install/${2:package_name}/lib/${2:package_name}/${1:node_name}\"",
							"args": [],
							"stopAtEntry": false,
							"cwd": "^\"\\${workspaceFolder}\"",
							"environment": [],
							"externalConsole": false,
							"MIMode": "gdb",
							"setupCommands": [
								{
									"description": "Enable pretty-printing for gdb",
									"text": "-enable-pretty-printing",
									"ignoreFailures": true
								}
							],
							"miDebuggerPath": "/usr/bin/gdb"
						}
					}
				]
			}
		]
	}
}
