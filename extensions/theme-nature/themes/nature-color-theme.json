	"tokenColors": [
		{
			"name": "Embedded code",
			"scope": [
				"meta.embedded",
				"source.groovy.embedded",
				"variable.legacy.builtin.python"
			],
			"settings": {
				"foreground": "#dce8d5"
			}
		},
		{
			"name": "Comments",
			"scope": [
				"comment",
				"punctuation.definition.comment"
			],
			"settings": {
				"foreground": "#91a58b"
			}
		},
		{
			"name": "Keywords and storage",
			"scope": [
				"keyword",
				"storage"
			],
			"settings": {
				"foreground": "#e4c58a"
			}
		},
		{
			"name": "Operators",
			"scope": "keyword.operator",
			"settings": {
				"foreground": "#dce8d5"
			}
		},
		{
			"name": "Strings",
			"scope": [
				"string",
				"markup.inline.raw",
				"markup.fenced_code.block"
			],
			"settings": {
				"foreground": "#b5d68b"
			}
		},
		{
			"name": "Regular expressions",
			"scope": "string.regexp",
			"settings": {
				"foreground": "#9dccb7"
			}
		},
		{
			"name": "Escape sequences",
			"scope": "constant.character.escape",
			"settings": {
				"foreground": "#e4c58a"
			}
		},
		{
			"name": "Numbers and constants",
			"scope": [
				"constant.numeric",
				"constant.language",
				"support.constant",
				"variable.other.constant"
			],
			"settings": {
				"foreground": "#cfb4d7"
			}
		},
		{
			"name": "Variables and parameters",
			"scope": [
				"variable",
				"variable.parameter"
			],
			"settings": {
				"foreground": "#dce8d5"
			}
		},
		{
			"name": "Language variables",
			"scope": "variable.language",
			"settings": {
				"foreground": "#e4c58a"
			}
		},
		{
			"name": "Functions",
			"scope": [
				"entity.name.function",
				"support.function"
			],
			"settings": {
				"foreground": "#9dcbd5"
			}
		},
		{
			"name": "Types and namespaces",
			"scope": [
				"entity.name.type",
				"entity.name.class",
				"entity.name.namespace",
				"support.type",
				"support.class",
				"entity.other.inherited-class"
			],
			"settings": {
				"foreground": "#9dccb7"
			}
		},
		{
			"name": "Tags",
			"scope": "entity.name.tag",
			"settings": {
				"foreground": "#9dccb7"
			}
		},
		{
			"name": "Attributes and properties",
			"scope": [
				"entity.other.attribute-name",
				"support.type.property-name",
				"meta.object-literal.key"
			],
			"settings": {
				"foreground": "#e4c58a"
			}
		},
		{
			"name": "CSS selectors",
			"scope": [
				"entity.other.attribute-name.class.css",
				"entity.other.attribute-name.id.css"
			],
			"settings": {
				"foreground": "#b5d68b"
			}
		},
		{
			"name": "Headings",
			"scope": [
				"markup.heading",
				"entity.name.section"
			],
			"settings": {
				"foreground": "#b5d68b",
				"fontStyle": "bold"
			}
		},
		{
			"name": "Emphasis",
			"scope": "markup.italic",
			"settings": {
				"fontStyle": "italic"
			}
		},
		{
			"name": "Strong emphasis",
			"scope": "markup.bold",
			"settings": {
				"fontStyle": "bold"
			}
		},
		{
			"name": "Strikethrough",
			"scope": "markup.strikethrough",
			"settings": {
				"fontStyle": "strikethrough"
			}
		},
		{
			"name": "Links",
			"scope": [
				"markup.underline.link",
				"string.other.link"
			],
			"settings": {
				"foreground": "#9dcbd5"
			}
		},
		{
			"name": "Quotes",
			"scope": "markup.quote",
			"settings": {
				"foreground": "#a4b5a0"
			}
		},
		{
			"name": "List markers",
			"scope": "punctuation.definition.list.begin",
			"settings": {
				"foreground": "#e4c58a"
			}
		},
		{
			"name": "Inserted text",
			"scope": "markup.inserted",
			"settings": {
				"foreground": "#b5d68b"
			}
		},
		{
			"name": "Deleted text",
			"scope": "markup.deleted",
			"settings": {
				"foreground": "#eeaaa0"
			}
		},
		{
			"name": "Changed text",
			"scope": "markup.changed",
			"settings": {
				"foreground": "#e4c58a"
			}
		},
		{
			"name": "Invalid syntax",
			"scope": "invalid",
			"settings": {
				"foreground": "#eeaaa0"
			}
		},
		{
			"name": "Deprecated syntax",
			"scope": "invalid.deprecated",
			"settings": {
				"fontStyle": "strikethrough"
			}
		}
	],
	"semanticHighlighting": true,
	"semanticTokenColors": {
		"namespace": "#9dccb7",
		"type": "#9dccb7",
		"class": "#9dccb7",
		"enum": "#9dccb7",
		"interface": "#9dccb7",
		"struct": "#9dccb7",
		"typeParameter": "#9dccb7",
		"parameter": "#dce8d5",
		"variable": "#dce8d5",
		"property": "#dce8d5",
		"enumMember": "#cfb4d7",
		"variable.readonly": "#cfb4d7",
		"property.readonly": "#cfb4d7",
		"function": "#9dcbd5",
		"method": "#9dcbd5",
		"decorator": "#e4c58a",
		"*.deprecated": {
			"strikethrough": true
		}
	}
}
