{
  "name": "vscode-html-languageserver",
  "description": "HTML language server",
  "version": "10.0.0",
  "author": "Microsoft Corporation",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "*"
  },
  "main": "./out/node/htmlServerMain",
  "dependencies": {
    "@vscode/l10n": "^0.0.18",
    "vscode-css-languageservice": "^7.0.0-next.4",
    "vscode-html-languageservice": "^6.0.0-next.3",
    "vscode-languageserver": "^11.0.0",
    "vscode-languageserver-textdocument": "^1.0.16",
    "vscode-uri": "^3.2.0"
  },
  "devDependencies": {
    "@types/node": "24.x",
    "glob": "^14.0.6"
  },
  "scripts": {
    "compile": "pnpm exec gulp compile-extension:html-language-features-server",
    "watch": "pnpm exec gulp watch-extension:html-language-features-server",
    "update-dependencies": "pnpm install vscode-languageserver@latest &&pnpm install vscode-css-languageservice@next && pnpm install vscode-html-languageservice@next",
    "test": "pnpm run compile && node ./test/index.js"
  }
