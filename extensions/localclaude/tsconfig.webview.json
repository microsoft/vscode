{
  // The UI (a VS Code webview): LocalClaude's React app and its preload bridge.
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "types": [],
    "paths": {
      "electron": ["./src/webview/vscode/electron.ts"]
    }
  },
  "include": ["src/webview/**/*", "src/preload/**/*", "src/shared/**/*"]
}
