{
  "name": "roboagent-authentication",
  "publisher": "vscode",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.80.0"
  },
  "activationEvents": [
    "onAuthenticationRequest:roboagent"
  ],
  "contributes": {
    "authentication": [
      {
        "label": "RoboAgent",
        "id": "roboagent"
      }
    ]
  },
  "main": "./out/extension.js",
  "browser": "./dist/browser/extension.js",
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/vscode": "^1.80.0",
    "typescript": "^5.0.0"
  }
}
