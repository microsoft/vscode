
{
	"compilerOptions": {
		"rootDir": "./src",
		"outDir": "./out",
		"module": "commonjs",
		"target": "es2022",
		"lib": [
			"es2022"
		],
		"types": [
			"node"
		],
		"moduleResolution": "node",
		"strict": true,
		"skipLibCheck": true,
		"sourceMap": true,
		"esModuleInterop": true
	},
	"include": [
		"src/**/*"
	]
}
