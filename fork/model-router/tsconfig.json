{
	"compilerOptions": {
		"target": "ES2023",
		"lib": ["ES2023", "DOM"],
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"strict": true,
		"noEmit": true,
		"allowImportingTsExtensions": true,
		"verbatimModuleSyntax": true,
		"erasableSyntaxOnly": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"types": ["node"],
		"skipLibCheck": true
	},
	"include": ["src", "test", "scripts"]
}
