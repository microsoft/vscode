// What ripple needs to know about this repository: pass it with `--config build/ripple/vscode.jsonc`.
// See README.md.
//
// Paths are relative to the repository root. In glob patterns, `*` and `?` match within one path
// segment, `**` matches any number of segments and `{a,b}` matches either alternative. In a list of
// patterns, a pattern starting with `!` excludes the paths it matches.
{
	// The modules ripple analyzes. Every other file is opaque: changing it affects the modules that
	// load it or read it by path. Declaration files (`.d.ts`) are never analyzed.
	"modules": [
		"src/**/*.ts",
		"src/**/*.mts"
	],

	// Non-relative module specifiers that name repository files, by prefix (like `paths` in
	// tsconfig.json). String literals with such a prefix are also read as module paths, for example
	// worker entry points.
	"pathAliases": {
		"vs/": "src/vs/"
	},

	// Test files, which must also be modules. `ripple plan` selects the unit and the integration
	// tests, and so do `ripple affected` and `ripple blame`. Each test runner then runs the selected
	// files it would run by default (see `--runList` in test/unit/README.md).
	"tests": {
		"unit": [
			"src/**/test/**/*.test.ts"
		],
		"integration": [
			"src/**/*.integrationTest.ts"
		],
		// The scripts that run the unit tests. The modules they name by a path alias run in every
		// test run, or serve requests of the tests, such as `'vs/workbench/test/common/utils'` and
		// `` `${outDir}/vs/platform/protocol/electron-main/protocolMainService.js` ``: a change that
		// reaches one of them runs every unit test.
		"runners": [
			"test/unit/**/*.js"
		]
	},

	// Files outside the module graph that every unit test depends on, by the reason the plan reports:
	// changing one of them runs every unit test, and every integration test, which the unit test
	// runners run too.
	"runEverything": {
		// remote/.npmrc has the Node.js version that the node.js test runner requires.
		"runtime version": [
			".npmrc",
			".nvmrc",
			"remote/.npmrc",
			"build/checksums/electron.txt",
			"build/lib/electron.ts"
		],
		// The test launchers read the application name from product.json.
		"test launcher": [
			"scripts/test.sh",
			"scripts/test.bat",
			"product.json"
		],
		"test runner": [
			"test/unit/**",
			"!test/unit/**/*.md"
		],
		// `npm run gulp transpile-client-esbuild` runs build/next through these files, with the npm
		// packages of build/package.json, such as esbuild. gulp loads the root gulpfile.mjs.
		"transpiler": [
			"gulpfile.mjs",
			"build/gulpfile.ts",
			"build/lib/esbuild.ts",
			"build/lib/compilation.ts",
			"build/lib/gulp/**",
			"build/next/**",
			// Inputs of the Dev Tunnels web bundle, which packaging builds, not the transpile step.
			"!build/next/devTunnelsWebEntry.js",
			"!build/next/devTunnelsShims/**",
			"build/package.json",
			"build/package-lock.json"
		],
		"compiler options": [
			"src/tsconfig*"
		],
		// How the test jobs install dependencies, and the key of their node_modules cache (see
		// .github/actions/restore-node-modules).
		"dependency installation": [
			"build/npm/**",
			"build/azure-pipelines/win32/exec.ps1",
			"build/.npmrc",
			"build/.cachesalt",
			"build/azure-pipelines/common/computeNodeModulesCacheKey.ts",
			"build/azure-pipelines/common/cacheKeys.ts"
		],
		// The macOS and Windows unit test jobs and the actions they use.
		"test job definition": [
			".github/workflows/pr.yml",
			".github/workflows/pr-darwin-test.yml",
			".github/workflows/pr-win32-test.yml",
			".github/workflows/node_modules_cache/**",
			".github/actions/setup-electron/**",
			".github/actions/restore-node-modules/**"
		],
		// ripple and this file decide what runs.
		"test planner": [
			"build/ripple/**",
			"!build/ripple/**/*.md"
		]
	},

	// Files outside the module graph that only the integration tests depend on, by the reason the
	// plan reports: changing one of them runs every integration test, but no unit test. As for
	// `runEverything`, so do the scripts that the listed scripts load through relative imports, and
	// the npm packages they load. Modules that integration tests load by a path that ripple cannot
	// resolve can be listed too.
	"runEveryIntegrationTest": {
		// The scripts that run the node.js integration tests and the Agent Host E2E suites.
		"integration test launcher": [
			"scripts/test-integration.sh",
			"scripts/test-integration.bat",
			"scripts/test-agent-host-e2e.sh",
			"scripts/test-agent-host-e2e.bat",
			"test/integration/agentHost/**"
		],
		// Modules, unlike the files above: integration tests fork src/bootstrap-fork.ts through
		// `FileAccess.asFileUri('bootstrap-fork')`, which ripple cannot resolve (see README.md), so a
		// change to it or to the bootstrap files it loads would select none of them.
		"forked process bootstrap": [
			"src/bootstrap-*.ts"
		]
	},

	"packages": {
		// Packages of package.json that build or run every test but that no `runEverything` script
		// above loads, such as a command line tool a test job runs: a version change runs every unit
		// test. ripple finds the packages that those scripts load itself (such as mocha and the test
		// runners' web server), with the packages they depend on (such as playwright through
		// @playwright/test).
		"toolchain": [],
		// npm scripts that install, build or run the unit tests in CI, with their `pre` and `post`
		// hooks: changing one runs every unit test. Changing any other script affects no test.
		"testScripts": [
			"install",
			"prepare",
			"gulp",
			"electron",
			"test-node",
			"test-browser",
			"test-browser-no-install"
		],
		// package.json fields that no test reads, besides npm metadata and scripts. Changing any other
		// field affects the code that reads package.json through `injectedGlobals`.
		"ignoredFields": [
			"distro"
		]
	},

	// Files the test runners inject as globals (`globalThis.<name>`): changing the file affects the
	// code that reads the global.
	"injectedGlobals": {
		"_VSCODE_PACKAGE_JSON": "package.json",
		"_VSCODE_PRODUCT_JSON": "product.json"
	},

	// Calls without side effects, besides JavaScript built-ins: functions by name, and the methods of
	// objects by the object's name. Calling one at module load does not tie a declaration to its
	// module's evaluation, and the properties of an object literal passed to one are tracked as members.
	"pure": {
		"functions": [
			"localize",
			"localize2",
			"createDecorator",
			"refineServiceDecorator"
		],
		"objects": [
			"URI",
			"nls",
			"ThemeIcon",
			"Codicon",
			"ContextKeyExpr"
		]
	},

	// Methods that code calls without naming them at the call site, besides the JavaScript protocols
	// (such as `toString`, `then` and iterators): code that reaches a class also reaches these methods.
	"implicitMethods": [
		"dispose"
	],

	// Functions whose first argument names a module or npm package that they load, like `require`:
	// a call depends on that module, so a version change of the package selects the code calling
	// them.
	"moduleLoaders": [
		"importAMDNodeModule",
		"resolveAmdNodeModulePath"
	],

	// The platform analysis (see Platform analysis in README.md): what a change runs on Windows
	// (`win32`) and macOS (`darwin`), besides Linux, which runs every test. `ripple plan` writes it
	// to the `platforms` of plan.json. A change runs an operating system's unit tier when:
	// - a changed file matches `paths`: every test that ripple selects runs there;
	// - the version of a package that `signals` names changed: the same;
	// - a changed declaration uses a signal, at most `depth` edges away: the tests that depend on it
	//   run there;
	// - a selected test uses a `selectedTestSignals` signal: it runs there;
	// - changed test code uses a `testSignals` signal, outside the `testLayers` it excludes: its
	//   test file runs there;
	// - changed code of a `modules` file (analyzed only for this) uses a signal, or a
	//   `testSignals` signal in `moduleTests`: the tests of its package run there.
	// The groups of an operating system are its own and `nonLinux`. `e2e` decides the end-to-end
	// tier (smoke, remote and browser integration tests) of both, with `paths` and `signals` only.
	// A change that runs every test (`runEverything`) runs both tiers on both.
	//
	// Signals name, as glob patterns: a declaration (`src/x.ts#name`, `src/x.ts#Class.member`) or
	// every declaration of a module (`src/x.ts`), a Node.js module or its export (`node:fs`,
	// `node:fs#realpath`), an npm package or its export (`npm:electron`,
	// `npm:electron#systemPreferences`), a property of a global object (`global:process.platform`)
	// or a string literal (`literal:win32`). A pattern also matches the members and exports of what
	// it names.
	//
	// The signals read the current operating system. Naming one does not (`OperatingSystem.Windows`,
	// `Platform.Mac`, `'win32'`): code that compares a value with one is tested on Linux with every
	// value, and tests that pin one with it, such as `env: { OS: OperatingSystem.Windows }`, behave
	// the same everywhere. Code that branches on the current one reads it too (`OS`, `isWindows`,
	// `process.platform`).
	"platforms": {
		"win32": {
			"signals": [
				"src/vs/base/common/platform.ts#isWindows",
				"src/vs/base/common/path.ts#win32",
				"node:path#win32",
				"node:path/win32",
				"node:os#EOL",
				"npm:@vscode/windows-*"
			],
			"paths": [
				"**/win32/**",
				"**/*.win32.ts",
				"**/*.{bat,cmd,ps1,psm1}",
				"build/win32/**",
				"resources/win32/**"
			],
			// Paths, the file system and processes behave differently on Windows: drive letters,
			// separators, CRLF line endings, file locking and quoting.
			"testSignals": [
				"src/vs/base/common/uri.ts#URI.file",
				"src/vs/base/common/{path,extpath,resources}.ts",
				"node:path",
				"node:fs",
				"node:os#tmpdir",
				"node:child_process",
				"npm:vscode#Uri.file"
			],
			// A test that branches on the operating system has code that only runs there, but most
			// selections include one: replaying Oct 20-29, this rule alone ran the unit tier for 30%
			// of the commits, and caught no labeled failure that the other rules miss.
			"selectedTestSignals": []
		},
		"darwin": {
			"signals": [
				"src/vs/base/common/platform.ts#isMacintosh",
				"npm:electron#systemPreferences"
			],
			"paths": [
				"**/darwin/**",
				"build/darwin/**",
				"resources/darwin/**"
			],
			// The temporary folder of macOS is behind a symbolic link (/var is /private/var).
			"testSignals": [
				"node:fs#realpath*",
				"node:os#tmpdir"
			],
			"selectedTestSignals": []
		},
		// What behaves differently on every operating system but Linux.
		"nonLinux": {
			"signals": [
				"src/vs/base/common/platform.ts#{isLinux,OS,platform}",
				"src/vs/base/common/process.ts#platform",
				"global:process.platform",
				"global:navigator.platform",
				"node:os#{platform,type}",
				"node:child_process",
				"node:fs#{realpath*,symlink*,chmod*,watch*}",
				"npm:{node-pty,@parcel/watcher,native-keymap,@vscode/sqlite3,@vscode/spdlog,kerberos,electron}"
			],
			"paths": [
				"src/bootstrap-*.ts",
				"src/{main,cli,server-main}.ts",
				"**/electron-main/**",
				"**/electron-utility/**",
				"test/{smoke,automation}/**",
				"scripts/**",
				".npmrc",
				"build/checksums/electron.txt",
				"build/lib/electron.ts",
				".github/workflows/**",
				".github/actions/**"
			],
			"selectedTestSignals": []
		},
		"e2e": {
			"paths": [
				".github/workflows/**",
				".github/actions/**",
				"test/{smoke,automation}/**",
				"src/bootstrap-*.ts",
				"src/{main,cli,server-main}.ts",
				"**/electron-main/**",
				"**/electron-utility/**",
				"src/vs/code/**",
				"scripts/**",
				".npmrc",
				"build/checksums/electron.txt"
			],
			// Native packages.
			"signals": [
				"npm:{node-pty,@parcel/watcher,native-keymap,electron}"
			]
		},
		// Changed test code in the browser layers runs the same everywhere.
		"testLayers": [
			"!**/common/**",
			"!**/browser/**"
		],
		"depth": 1,
		// Extensions are not part of the module graph: their changed code only decides whether
		// their tests run on an operating system.
		"modules": [
			"extensions/*/src/**/*.ts",
			"extensions/*/src/**/*.tsx"
		],
		"moduleTests": [
			"extensions/*/src/**/test/**",
			"extensions/*/src/**/*.test.ts"
		]
	}
}
