	"defaultTopic": "principles",
	"references": {
		"designing-for-ai": [
			{
				"title": "Microsoft HAX: Guidelines for Human-AI Interaction",
				"url": "https://www.microsoft.com/en-us/haxtoolkit/ai-guidelines/",
				"description": "A research-backed starting point for discussing AI experiences across initial use, ongoing interaction, errors, and changes over time."
			}
		],
		"typography": [
			{
				"title": "WCAG 2.2: Text Spacing",
				"url": "https://www.w3.org/WAI/WCAG22/Understanding/text-spacing.html",
				"description": "The user-override test exposes clipped or lost content when line, paragraph, letter, and word spacing change; its test values are not default type tokens."
			}
		],
		"colors": [
			{
				"title": "WCAG 2.2: Contrast (Minimum)",
				"url": "https://www.w3.org/WAI/WCAG22/Understanding/contrast-minimum.html",
				"description": "Explains text-contrast thresholds and exceptions for large text and inactive controls, helping evaluate rendered foreground/background pairs rather than swatches."
			}
		],
		"motion": [
			{
				"title": "WCAG 2.2: Animation from Interactions",
				"url": "https://www.w3.org/WAI/WCAG22/Understanding/animation-from-interactions.html",
				"description": "Clarifies the AAA essential-motion exception and distinguishes interaction-triggered animation from automatic animation when evaluating reduced-motion behavior."
			}
		],
		"accessibility": [
			{
				"title": "ARIA APG: Developing a Keyboard Interface",
				"url": "https://www.w3.org/WAI/ARIA/apg/practices/keyboard-interface/",
				"description": "Details tab-stop placement, focus versus selection, and navigation inside composite widgets, extending this topic's basic keyboard-operability checks."
			}
		]
	},
