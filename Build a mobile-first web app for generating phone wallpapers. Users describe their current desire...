eWallpaper] \u003d useState\u003cWallpaper | null\u003e(null);\\n\\n  // Adjustment states\\n  const [brightness, setBrightness] \u003d useState(100);\\n  const [contrast, setContrast] \u003d useState(100);\\n  const [saturation, setSaturation] \u003d useState(100);\\n  const [isAdjusting, setIsAdjusting] \u003d useState(false);\\n\\n  const canvasRef \u003d useRef\u003cHTMLCanvasElement\u003e(null);\\n\\n  // Reset adjustments when closing/changing selection\\n  useEffect(() \u003d\u003e {\\n    if (!selectedWallpaper) {\\n      setBrightness(100);\\n      setContrast(100);\\n      setSaturation(100);\\n      setIsAdjusting(false);\\n    }\\n  }, [selectedWallpaper]);\\n\\n  const handleGenerate \u003d async (isRemix: boolean \u003d false) \u003d\u003e {\\n    if (!vibe.trim()) return;\\n\\n    setGenState({ isGenerating: true, error: null, currentProgress: 0 });\\n    \\n    const newWallpapers: Wallpaper[] \u003d [];\\n    const prompt \u003d isRemix \u0026\u0026 referenceWallpaper ? referenceWallpaper.prompt : vibe;\\n    const refImage \u003d isRemix \u0026\u0026 referenceWallpaper ? referenceWallpaper.url : undefined;\\n\\n    try {\\n      // Generate 4 variations in parallel\\n      const results \u003d await Promise.all([\\n        generateWallpapers(prompt, aspectRatio, imageSize, refImage),\\n        generateWallpapers(prompt, aspectRatio, imageSize, refImage),\\n        generateWallpapers(prompt, aspectRatio, imageSize, refImage),\\n        generateWallpapers(prompt, aspectRatio, imageSize, refImage),\\n      ]);\\n\\n      const timestamp \u003d Date.now();\\n      results.forEach((url, index) \u003d\u003e {\\n        newWallpapers.push({\\n          id: `${timestamp}-${index}`,\\n          url,\\n          prompt,\\n          aspectRatio,\\n          resolution: imageSize\\n        });\\n      });\\n\\n      setWallpapers(prev \u003d\u003e [...newWallpapers, ...prev]);\\n      setGenState({ isGenerating: false, error: null, currentProgress: 100 });\\n 