\\nimport { AspectRatio, ImageSize, Wallpaper, GenerationState, ImageAdjustments } from \u0027../types\u0027;\\nimport { generateWallpapers } from \u0027../services/geminiService\u0027;\\n\\n// Supported values are \\\"1:1\\\", \\\"3:4\\\", \\\"4:3\\\", \\\"9:16\\\", and \\\"16:9\\\"\\nconst ASPECT_RATIOS: AspectRatio[] \u003d [\u00271:1\u0027, \u00273:4\u0027, \u00274:3\u0027, \u00279:16\u0027, \u002716:9\u0027];\\nconst IMAGE_SIZES: ImageSize[] \u003d [\u00271K\u0027, \u00272K\u0027, \u00274K\u0027];\\n\\ninterface WallpaperAppProps {\\n  onResetKey: () \u003d\u003e void;\\n}\\n\\nconst WallpaperApp: React.FC\u003cWallpaperAppProps\u003e \u003d ({ onResetKey }) \u003d\u003e {\\n  const [vibe, setVibe] \u003d useState(\u0027\u0027);\\n  const [aspectRatio, setAspectRatio] \u003d useState\u003cAspectRatio\u003e(\u00279:16\u0027);\\n  const [imageSize, setImageSize] \u003d useState\u003cImageSize\u003e(\u00271K\u0027);\\n  const [wallpapers, setWallpapers] \u003d useState\u003cWallpaper[]\u003e([]);\\n  const [genState, setGenState] \u003d useState\u003cGenerationState\u003e({ isGenerating: false, error: null, currentProgress: 0 });\\n  const [selectedWallpaper, setSelectedWallpaper] \u003d useState\u003cWallpaper | null\u003e(null);\\n  const [referenceWallpaper, setReferenceWallpaper] \u003d useState\u003cWallpaper | null\u003e(null);\\n\\n  // Local adjustment state for the currently viewing image\\n  const [localAdjustments, setLocalAdjustments] \u003d useState\u003cImageAdjustments\u003e({\\n    brightness: 100,\\n    contrast: 100,\\n    saturation: 100\\n  });\\n  const [isAdjusting, setIsAdjusting] \u003d useState(false);\\n\\n  // Sync local adjustments with the selected wallpaper\\n  useEffect(() \u003d\u003e {\\n    if (selectedWallpaper) {\\n      setLocalAdjustments(selectedWallpaper.adjustments || {\\n        brightness: 100,\\n        contrast: 100,\\n        saturation: 100\\n      });\\n      setIsAdjusting(false);\\n    }\\n  }, [selectedWallpaper?.id]);\\n\\n  // Update the wallpapers list when local adjustments change\\n  const updateWallpaperAdjustments \u003d (adj: ImageAdjustments) \u003d\u003e {\\n    setLocalAdjustments(adj);\\n    if (selectedWallpaper) {\\n      setWallpapers(prev \u003d\u003e prev.map(wp \u003d\u003e \\n        wp.id \u003d\u003d\u003d selectedWallpaper.id ? { ...wp, adjustments: adj } : wp\\n      ));\\n    }\\n  };\\n\\n  const handleGenerate \u003d async (isRemix: boolean \u003d false, overrideRef?: string) \u003d\u003e {\\n    if (!vibe.trim()) return;\\n\\n    setGenState({ isGenerating: true, error: null, currentProgress: 0 });\\n    \\n    const newWallpapers: Wallpaper[] \u003d [];\\n    const prompt \u003d isRemix \u0026\u0026 referenceWallpaper ? referenceWallpaper.prompt : vibe;\\n    const refImage \u003d overrideRef || (isRemix \u0026\u0026 referenceWallpaper ? referenceWallpaper.url : undefined);\\n\\n    try {\\n      // Generate 4 variations in parallel\\n      const results \u003d await Promise.all([\\n        generateWallpapers(prompt, aspectRatio, imageSize, refImage),\\n        generateWallpapers(prompt, aspectRatio, imageSize, refImage),\\n        generateWallpapers(prompt, aspectRatio, imageSize, refImage),\\n        generateWallpapers(prompt, aspectRatio, imageSize, refImage),\\n      ]);\\n\\n      const timestamp \u003d Date.now();\\n      results.forEach((url, index) \u003d\u003e {\\n        newWallpapers.push({\\n          id: `${timestamp}-${index}`,\\n          url,\\n          prompt,\\n          aspectRatio,\\n          resolution: imageSize,\\n          adjustments: { brightness: 100, contrast: 100, saturation: 100 }\\n        });\\n      });\\n\\n      setWallpapers(prev \u003d\u003e [...newWallpapers, ...prev]);\\n      setGenState({ isGenerating: false, error: null, currentProgress: 100 });\\n      \\n      setTimeout(() \u003d\u003e {\\n        window.scrollTo({ top: 0, behavior: \u0027smooth\u0027 });\\n      }, 100);\\n\\n    } catch (error: any)